# Nenhuma variável é obrigatória — o app roda sem .env.
# O Metro lê este arquivo só na inicialização; depois de editar, reinicie com
# `pnpm start -c`.

# Login que abre por padrão na aba Perfil. O endpoint por trás
# (`/users/{login}`) é público, então não exige autenticação.
# Padrão quando ausente: octocat
EXPO_PUBLIC_PROFILE_USERNAME=

# true roda sobre dados em memória, sem tocar na rede. Útil para navegar a UI
# sem gastar o rate limit anônimo do GitHub (60 requisições por hora).
EXPO_PUBLIC_USE_MOCK=false
